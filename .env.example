# Server Environment Variables
PORT=4000
DATABASE_URL=postgresql://postgres:[PASSWORD]@[HOST]:[PORT]/[DB]
JWT_SECRET=your_jwt_super_secret_key_minimum_32_characters
QR_HMAC_SECRET=your_qr_hmac_signing_key_minimum_32_characters
ORGANIZER_PROVISION_KEY=your_organizer_provision_secret_key
GEMINI_API_KEY=your_gemini_api_key_here
CLIENT_ORIGIN=http://localhost:5173

# Client Environment Variables (client/.env)
VITE_API_URL=http://localhost:4000
VITE_SOCKET_URL=http://localhost:4000
